{
  "name": "gatepulse-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "GatePulse - Walk-in Job Drive Intelligence & Gate Navigation Platform",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=services/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:api": "npm run build --workspace=services/api",
    "build:web": "npm run build --workspace=apps/web",
    "build": "npm run build --workspaces --if-present"
  },
  "keywords": [
    "gatepulse",
    "walkin-drives",
    "monorepo",
    "express",
    "gemini",
    "nextjs",
    "expo",
    "supabase"
  ],
  "author": "GatePulse Team",
  "license": "MIT"
}
