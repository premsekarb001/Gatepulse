{
  "name": "gatepulse-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "GatePulse - Walk-in Job Drive Intelligence & Gate Navigation Platform",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=services/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "auto-sync": "node scripts/auto-sync.js",
    "watch-sync": "node scripts/watch-and-sync.js",
    "build:shared": "npm --prefix packages/shared run build",
    "build:api": "npm run build --workspace=services/api",
    "build:web": "npm --prefix apps/web run build",
    "build": "npm run build:shared && npm run build:web"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "keywords": [
    "gatepulse",
    "walkin-drives",
    "monorepo",
    "express",
    "gemini",
    "nextjs",
    "expo",
    "supabase"
  ],
  "author": "GatePulse Team",
  "license": "MIT"
}
